# ===== Nguồn dữ liệu GIÁ (chọn 1 hoặc nhiều) =====
# vnstock / VPS / Entrade / SSI - tuỳ nhà cung cấp bạn đăng ký
PRICE_PROVIDER=vnstock_real          # mock | vnstock_real | vnstock | ssi
SSI_API_KEY=
SSI_API_SECRET=

# ===== Nguồn TIN TỨC =====
NEWS_PROVIDER=google_news           # mock | cafef | vietstock
FIRECRAWL_API_KEY=

# ===== Telegram Alert =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== App =====
FLASK_PORT=8000
DB_PATH=stock_ai.db
# ===== Gemini API (tuỳ chọn — để trống thì web vẫn chạy bình thường, dùng fallback) =====
GEMINI_API_KEY=
USE_GEMINI=false

# ===== Cache TTL (giây) =====
CACHE_TTL_PRICE=60
CACHE_TTL_NEWS=300
CACHE_TTL_SENTIMENT=3600
CACHE_TTL_GEMINI=600

# ===== Gemini: dán key vào GEMINI_API_KEY rồi đổi USE_GEMINI=true =====
GEMINI_MODEL=gemini-2.5-flash

# ===== Phân tích cơ bản (BCTC thật từ vnstock) =====
FUNDAMENTAL_PROVIDER=vnstock
VNSTOCK_SOURCE=VCI
REPORTS_CSV=data/broker_reports.csv
# true = khi bật server tự nạp sẵn BCTC cả danh mục ở nền (nên bật khi demo)
WARM_CACHE=true

# Số CTCK tối đa hiện trong bảng định giá (mặc định 6)
REPORTS_MAX=6
